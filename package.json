{
  "name": "boothwall",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "demo": "node scripts/boothwall/index.mjs demo",
    "try": "node scripts/boothwall/index.mjs demo --tv",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "lint:scripts": "eslint scripts",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:dev": "pnpm --filter @boothwall/api dev",
    "web:dev": "pnpm --filter @boothwall/web dev",
    "tv:start": "pnpm --filter @boothwall/tv start",
    "tv:build:debug": "pnpm --filter @boothwall/tv build:debug",
    "tv:build:release": "pnpm --filter @boothwall/tv build:release",
    "tv:vvd:start": "pnpm --filter @boothwall/tv vvd:start",
    "tv:run:vvd": "pnpm --filter @boothwall/tv run:vvd",
    "tv:vvd:start:1080": "pnpm --filter @boothwall/tv vvd:start:1080",
    "tv:vvd:restart:1080": "pnpm --filter @boothwall/tv vvd:restart:1080",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall/link-cf-delegates.mjs",
    "remote": "node scripts/remote/booth-remote.mjs",
    "boothwall": "node scripts/boothwall/index.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "qrcode-generator": "2.0.4",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": "prettier --write"
  }
}
