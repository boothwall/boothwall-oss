{
  "name": "@boothwall/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./testing": "./src/testing/index.ts",
    "./host": "./src/host/index.ts",
    "./worker": "./src/index.ts"
  },
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node ../../scripts/boothwall/index.mjs migrate --local",
    "db:migrate:remote": "node ../../scripts/boothwall/index.mjs migrate"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@boothwall/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@boothwall/tsconfig": "workspace:*",
    "cf": "1.0.0-beta.12",
    "drizzle-kit": "^0.31.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
