{
  "name": "@boothwall/tv",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "build:debug": "NPM_EXECPATH=$(which pnpm) react-native build-vega --build-type Debug",
    "build:release": "NPM_EXECPATH=$(which pnpm) react-native build-vega --build-type Release",
    "clean": "rm -rf build dist buildinfo.json .tmp",
    "vvd:start": "vega virtual-device start",
    "vvd:stop": "vega virtual-device stop",
    "vvd:start:1080": "vega virtual-device start --display-res=1920,1080",
    "vvd:restart:1080": "(vega virtual-device stop >/dev/null 2>&1 || true) && pnpm vvd:start:1080 && pnpm run:vvd",
    "run:vvd": "vega run-app build/aarch64-debug/tv_aarch64.vpkg com.boothwall.app.main -d VirtualDevice",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "jest"
  },
  "dependencies": {
    "@amazon-devices/react-native-async-storage__async-storage": "2.1.9000000000-rn-83",
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "@amazon-devices/react-native-w3cmedia": "2.3.4-rn-83",
    "@boothwall/shared": "workspace:*",
    "@boothwall/wall-ui": "workspace:*",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@babel/plugin-transform-export-namespace-from": "^8.0.1",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.0"
  },
  "kepler": {
    "projectType": "application",
    "appName": "boothwall",
    "targets": [
      "tv"
    ]
  },
  "exports": {
    "./input": "./src/platform/input/index.ts",
    "./keep-awake": "./src/features/keep-awake/index.ts"
  }
}
