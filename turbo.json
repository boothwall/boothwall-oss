{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "packages/tsconfig/*.json",
    "eslint.config.mjs",
    "prettier.config.mjs",
    ".nvmrc",
    ".node-version"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV"],
      "outputs": [".cloudflare/output/**"]
    },
    "typecheck": {
      "env": [],
      "outputs": []
    },
    "lint": {
      "env": [],
      "outputs": []
    },
    "test": {
      "env": ["NODE_ENV"],
      "outputs": []
    },
    "dev": {
      "env": ["PORT", "NODE_ENV"],
      "cache": false,
      "persistent": true
    }
  },
  "agentGuidance": false
}
