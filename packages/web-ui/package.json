  "devDependencies": {
    "@boothwall/shared": "workspace:*",
    "@boothwall/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": "19.2.0",
    "tailwindcss": "^4.3.3"
  }
}
