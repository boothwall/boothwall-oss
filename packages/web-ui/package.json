{
  "name": "@boothwall/web-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/theme/styles.css"
  },
  "imports": {
    "#foundations": "./src/foundations/index.ts",
    "#primitives": "./src/primitives/index.ts",
    "#composites": "./src/composites/index.ts",
    "#patterns": "./src/patterns/index.ts",
    "#shells": "./src/shells/index.ts",
    "#brand": "./src/brand/index.ts",
    "#kit": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p preview/tsconfig.json",
    "lint": "eslint src preview",
    "test": "vitest run",
    "preview:kit": "vite --config preview/vite.config.ts"
  },
  "dependencies": {
    "@boothwall/brand": "workspace:*",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
